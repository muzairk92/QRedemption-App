<?xml version="1.0" encoding="utf-8"?>
<!--
    Debug builds only: plain HTTP is allowed so the app can reach a Portal running on
    a developer machine (for example http://192.168.1.20:8000). The app itself still
    refuses http:// addresses in release builds.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
