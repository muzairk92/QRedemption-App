<?xml version="1.0" encoding="utf-8"?>
<!--
    Nothing is backed up or transferred (Android 12+). Stored data is encrypted with a
    key that never leaves this device's Android Keystore, so a copy would be unreadable.
    Older versions are covered by android:allowBackup="false" in the manifest.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </device-transfer>
</data-extraction-rules>
