<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Shown while the app starts (androidx.core:core-splashscreen). -->
    <style name="Theme.RedemptionTester.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.RedemptionTester</item>
    </style>

    <!-- Window theme only. Every screen is drawn with Compose Material 3. -->
    <style name="Theme.RedemptionTester" parent="android:Theme.Material.Light.NoActionBar" />
</resources>
